# ─── Polymarket Wallet Configuration ────────────────────────────
# Your private key (export from https://reveal.polymarket.com or your wallet)
POLYMARKET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Your Polymarket funder/proxy address (the address you deposit USDC to)
POLYMARKET_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS_HERE

# Signature type: 0=EOA/MetaMask, 1=Email/Magic, 2=Browser proxy
POLYMARKET_SIGNATURE_TYPE=1

# ─── Leaderboard Configuration ─────────────────────────────────
# Category: OVERALL, POLITICS, SPORTS, CRYPTO, CULTURE, WEATHER, ECONOMICS, TECH, FINANCE
LEADERBOARD_CATEGORY=OVERALL

# Time period: DAY, WEEK, MONTH, ALL
LEADERBOARD_TIME_PERIOD=WEEK

# Order by: PNL or VOL
LEADERBOARD_ORDER_BY=PNL

# Number of top traders to follow (1-50)
LEADERBOARD_TOP_N=5

# Minimum PnL to qualify as a trader to follow
LEADERBOARD_MIN_PNL=0

# ─── Risk Management ───────────────────────────────────────────
# Max USD per individual trade
RISK_MAX_POSITION_SIZE_USD=50

# Max total portfolio exposure in USD
RISK_MAX_TOTAL_EXPOSURE_USD=500

# Max number of concurrent positions
RISK_MAX_POSITIONS=20

# Price bounds (don't trade outside this range)
RISK_MIN_PRICE=0.05
RISK_MAX_PRICE=0.95

# Percentage of leader's position to mirror (0.0 - 1.0)
RISK_ALLOCATION_PCT=0.10

# Stop loss threshold (close position if loss exceeds this %)
RISK_STOP_LOSS_PCT=0.50

# ─── Bot Settings ──────────────────────────────────────────────
# Leaderboard refresh interval in seconds
LEADERBOARD_POLL_INTERVAL=300

# Position check interval in seconds
POSITION_POLL_INTERVAL=30

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Dry run mode (true = simulate, false = live trading)
DRY_RUN=true
